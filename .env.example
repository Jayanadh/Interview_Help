# ─────────────────────────────────────────────────────────────
#  Help_Interview — copy to `.env` and fill in the keys you have.
#  The app detects what you gave it and routes automatically;
#  you never pick a provider or a model in the UI.
# ─────────────────────────────────────────────────────────────
#
#  Ears and brain are chosen SEPARATELY.
#    brain  → Claude if you have an Anthropic key, else Groq, else OpenAI
#    ears   → Deepgram if you have one, else Groq, else OpenAI
#
#  So the cheapest good setup is a Groq key for transcription plus an
#  Anthropic key for answers. You do NOT need Deepgram for Claude.
#
#    GROQ only                  fastest + cheapest   (~$0.09 / 45min)
#    GROQ + ANTHROPIC           best value           (~$0.54 / 45min)
#    DEEPGRAM + ANTHROPIC       best quality         (~$1.20 / 45min)
#    OPENAI only                one key              (~$0.70 / 45min)

# ── Transcription and/or answers. Starts with gsk_ ───────────
# console.groq.com/keys
GROQ_API_KEY=

# ── Answers. Starts with sk-ant-api ──────────────────────────
# console.anthropic.com → Settings → API keys
#
# NOTE: this must be an API KEY. A Claude Pro/Max or Claude Code login
# token (sk-ant-oat…) will NOT work — it authenticates as a bearer token
# tied to the Claude Code client, so every request here returns 401.
# The app detects one and tells you, rather than failing mid-interview.
# ANTHROPIC_API_KEY=

# ── Transcription only. 32-character hex ─────────────────────
# console.deepgram.com
# DEEPGRAM_API_KEY=

# ── Both halves, via OpenAI. Starts with sk- ─────────────────
# OPENAI_API_KEY=


# ── Optional tuning ──────────────────────────────────────────

# Pause before answering, ms. Lower = snappier, more false fires. Default 600.
SILENCE_MS=

# Voice-detection threshold (Groq path only). Raise if a noisy room
# triggers constantly, lower if quiet speech is missed. Default 450.
SPEECH_RMS=

# "full" (flowing spoken paragraphs) or "brief" (headline + bullets).
# Toggle live with Cmd/Ctrl+Shift+B. Default "full".
ANSWER_STYLE=

# "fast" | "default" | "deep". Default "default".
# On Claude, "fast" uses Haiku 4.5 instead of Opus 5 — quicker and cheaper.
ANSWER_MODE=

# Starting language for the screen solver. Any of 236 names, fuzzy-matched;
# you can change it mid-interview in the overlay. Default Python.
CODE_LANGUAGE=

# Ceiling on a code answer, in tokens. Default 2200.
MAX_CODE_TOKENS=

# ── Troubleshooting ──────────────────────────────────────────

# "screencapturekit" (default) or "coreaudio". Switch if system audio
# connects but delivers pure silence.
# AUDIO_BACKEND=

# Stand a PNG in for the display, so the screen solver can be exercised
# without granting Screen Recording. Dev only.
# SCREEN_FIXTURE=scripts/selftest/captured.png
